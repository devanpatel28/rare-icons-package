# Dependencies
node_modules/

# Build output (regenerated by npm run build)
dist/

# Local package archives
*.tgz

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/

# Python cache (if using SVG processing scripts)
__pycache__/
*.py[cod]

# Generated conversion error report
conversion-errors.json


# Keep icon-svgs folder, but ignore all files inside it
icon-svgs/*
!icon-svgs/.gitkeep

# Keep src/icons folder, but ignore all generated components
src/icons/*
!src/icons/.gitkeep
