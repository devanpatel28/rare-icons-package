{
  "name": "rare-icons",
  "version": "1.0.0",
  "description": "A customizable SVG icon library for React and Next.js",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "convert:icons": "node convert-icons.mjs",
    "generate:exports": "node generate-exports.mjs",
    "build": "npm run convert:icons && npm run generate:exports && tsup && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
